{
  "$defs": {
    "Concern": {
      "additionalProperties": false,
      "description": "Mối quan tâm cần xem xét, có thể liên quan đến nhiều yêu cầu.",
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "description": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "obligation_ids": {
          "default": [],
          "items": {
            "maxLength": 128,
            "minLength": 1,
            "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
            "type": "string"
          },
          "title": "Obligation Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "description"
      ],
      "title": "Concern",
      "type": "object"
    },
    "Obligation": {
      "additionalProperties": false,
      "description": "Yêu cầu bắt buộc: được giao cho task hoặc ghi rõ là chưa phân công.",
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "description": {
          "maxLength": 20000,
          "minLength": 1,
          "title": "Description",
          "type": "string"
        },
        "source_excerpt": {
          "anyOf": [
            {
              "maxLength": 20000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Optional quotation from the original request.",
          "title": "Source Excerpt"
        }
      },
      "required": [
        "id",
        "description"
      ],
      "title": "Obligation",
      "type": "object"
    },
    "PlanningEvidence": {
      "additionalProperties": false,
      "description": "Evidence supplied by a retrieval adapter, not retrieved by this package.",
      "properties": {
        "id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Id",
          "type": "string"
        },
        "document_id": {
          "maxLength": 128,
          "minLength": 1,
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
          "title": "Document Id",
          "type": "string"
        },
        "content": {
          "maxLength": 100000,
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "locator": {
          "anyOf": [
            {
              "maxLength": 20000,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Section, page, or other locator.",
          "title": "Locator"
        }
      },
      "required": [
        "id",
        "document_id",
        "content"
      ],
      "title": "PlanningEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Câu hỏi gốc và dữ liệu đã biết từ các bước trước, nếu có.",
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "request_id": {
      "maxLength": 128,
      "minLength": 1,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
      "title": "Request Id",
      "type": "string"
    },
    "request": {
      "maxLength": 100000,
      "minLength": 1,
      "title": "Request",
      "type": "string"
    },
    "obligations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Obligation"
      },
      "maxItems": 256,
      "title": "Obligations",
      "type": "array"
    },
    "concerns": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Concern"
      },
      "maxItems": 256,
      "title": "Concerns",
      "type": "array"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PlanningEvidence"
      },
      "maxItems": 256,
      "title": "Evidence",
      "type": "array"
    },
    "available_roles": {
      "default": [],
      "items": {
        "maxLength": 128,
        "minLength": 1,
        "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$",
        "type": "string"
      },
      "maxItems": 256,
      "title": "Available Roles",
      "type": "array"
    },
    "max_tasks": {
      "default": 16,
      "maximum": 256,
      "minimum": 1,
      "title": "Max Tasks",
      "type": "integer"
    }
  },
  "required": [
    "request_id",
    "request"
  ],
  "title": "PlanningInput",
  "type": "object"
}
